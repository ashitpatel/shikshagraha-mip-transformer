{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/shikshagraha-mip-transformer/mip-usage-event.schema.json",
  "title": "MIP usage event",
  "description": "One event in the life of one MIP use at one school: offered, chosen, started, task progress, completed, abandoned, or outcome reported. Events are append-only; a use is the set of events sharing a use_id. PRIVACY RULES (enforced by the schema where possible): no student-level data of any kind (CL-G9); no personal names, phone numbers or emails; schools and owners are pseudonymous; context fields are coarse bands. Self-reported fields are marked as such.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "event_id", "use_id", "event_type", "occurred_at", "school", "owner_role"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "event_id": { "type": "string", "format": "uuid" },
    "use_id": { "type": "string", "format": "uuid", "description": "Groups all events of one MIP use at one school" },
    "event_type": { "enum": ["offered", "chosen", "started", "task_progress", "completed", "abandoned", "outcome_reported"] },
    "occurred_at": { "type": "string", "format": "date-time" },

    "school": {
      "type": "object",
      "additionalProperties": false,
      "required": ["school_pseudo_id"],
      "properties": {
        "school_pseudo_id": { "type": "string", "pattern": "^s_[0-9a-f]{16}$", "description": "Keyed hash of the UDISE code; the key is held by the platform, never in logs" },
        "state": { "type": "string", "description": "State or UT name" },
        "district_pseudo_id": { "type": "string", "pattern": "^d_[0-9a-f]{12}$" },
        "school_level": { "enum": ["primary", "upper_primary", "secondary", "higher_secondary", "composite"] },
        "management": { "enum": ["government", "government_aided", "local_body", "other"] },
        "enrolment_band": { "enum": ["<50", "50-150", "151-300", "301-1000", ">1000"] },
        "location": { "enum": ["rural", "urban"] },
        "medium": { "type": "string", "description": "Medium of instruction, e.g. Hindi, Tamil, English" }
      }
    },
    "owner_role": { "enum": ["HM", "teacher", "SMC", "CRP", "BRP", "DIET", "other"], "description": "Role only; no identity" },
    "owner_pseudo_id": { "type": "string", "pattern": "^o_[0-9a-f]{16}$", "description": "Optional keyed hash, to link one owner's repeated uses" },

    "mip": {
      "type": "object",
      "additionalProperties": false,
      "description": "Required for 'offered' and 'chosen'; optional afterwards",
      "properties": {
        "source_ref": { "type": "string" },
        "domain": { "type": "string" },
        "variant_id": { "type": "string", "pattern": "^v1:[0-9a-f]{16}$" },
        "variant_kind": { "enum": ["baseline", "transformed", "seed"] },
        "gates": {
          "type": "object",
          "additionalProperties": { "enum": ["APPLY", "PARTIAL", "CONDITIONAL", "ABSTAIN"] },
          "description": "Gate decisions for a transformed variant, e.g. {connected_learning: APPLY}"
        },
        "cards_applied": { "type": "array", "items": { "type": "string", "pattern": "^(CL|PB|EB)-[a-z-]+$" } }
      }
    },

    "offer": {
      "type": "object",
      "additionalProperties": false,
      "description": "Required on 'offered'. Logging the policy and probabilities makes later unbiased (off-policy) evaluation of any recommender possible.",
      "required": ["offered_variant_ids", "policy", "first_shown_variant_id"],
      "properties": {
        "offered_variant_ids": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^v1:[0-9a-f]{16}$" } },
        "first_shown_variant_id": { "type": "string", "pattern": "^v1:[0-9a-f]{16}$" },
        "policy": { "type": "string", "description": "e.g. 'fixed:baseline-first', 'uniform-random', 'recommender:v0.1'" },
        "first_shown_probability": { "type": "number", "exclusiveMinimum": 0, "maximum": 1, "description": "Probability the policy had of showing first_shown_variant_id first. Required for any randomised or learned policy." }
      }
    },

    "choice": {
      "type": "object",
      "additionalProperties": false,
      "description": "Required on 'chosen'",
      "required": ["chosen_variant_id"],
      "properties": {
        "chosen_variant_id": { "type": "string", "pattern": "^v1:[0-9a-f]{16}$" },
        "open_question_answers": {
          "type": "object",
          "additionalProperties": { "type": "string", "maxLength": 300 },
          "description": "Answers to the variant's open_questions, e.g. whether a discretionary amount is confirmed. Free text; must not contain personal data."
        }
      }
    },

    "progress": {
      "type": "object",
      "additionalProperties": false,
      "description": "On 'task_progress', 'completed', 'abandoned'",
      "properties": {
        "tasks_total": { "type": "integer", "minimum": 1 },
        "tasks_done": { "type": "integer", "minimum": 0 },
        "task_seq_done": { "type": "array", "items": { "type": "integer", "minimum": 1 } },
        "weeks_elapsed": { "type": "number", "minimum": 0 },
        "abandon_reason": { "enum": ["time", "staff_change", "resources", "not_relevant", "too_complex", "safety_concern", "other"], "description": "On 'abandoned'" }
      }
    },

    "outcome": {
      "type": "object",
      "additionalProperties": false,
      "description": "On 'outcome_reported'. All fields are the owner's self-report unless 'verified_by' is set.",
      "properties": {
        "indicators": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["indicator", "met"],
            "properties": {
              "indicator": { "type": "string", "description": "Text of the variant's success indicator" },
              "met": { "enum": ["yes", "partly", "no", "not_measured"] },
              "aggregate_value": { "type": "number", "description": "Optional class- or school-level figure, e.g. % of students. Never per student." }
            }
          }
        },
        "owner_rating": { "type": "integer", "minimum": 1, "maximum": 5, "description": "Self-reported: how useful was this MIP?" },
        "would_repeat": { "type": "boolean" },
        "effort_band": { "enum": ["<2h", "2-5h", "5-10h", ">10h"], "description": "Owner's total effort" },
        "safeguarding_issue_reported": { "type": "boolean", "description": "Set true if anything went wrong for children; details go to the platform's safeguarding process, not this log" },
        "story_ref": { "type": "string", "description": "Reference to an improvement story in the Commons #631 format, if one was written" },
        "verified_by": { "enum": ["none", "CRP", "BRP", "DIET", "partner_org"] }
      }
    }
  },

  "allOf": [
    { "if": { "properties": { "event_type": { "const": "offered" } } }, "then": { "required": ["mip", "offer"] } },
    { "if": { "properties": { "event_type": { "const": "chosen" } } }, "then": { "required": ["mip", "choice"] } },
    { "if": { "properties": { "event_type": { "enum": ["task_progress", "completed", "abandoned"] } } }, "then": { "required": ["progress"] } },
    { "if": { "properties": { "event_type": { "const": "abandoned" } } }, "then": { "properties": { "progress": { "required": ["abandon_reason"] } } } },
    { "if": { "properties": { "event_type": { "const": "outcome_reported" } } }, "then": { "required": ["outcome"] } }
  ]
}
